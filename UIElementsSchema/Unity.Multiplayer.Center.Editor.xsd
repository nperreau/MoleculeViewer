    </xs:complexContent>
  </xs:complexType>
  <xs:element name="ImageWithPlaceholderElement" xmlns:q8="UnityEngine.UIElements" substitutionGroup="q8:Image" type="tns:ImageWithPlaceholderElementType" />
  <xs:complexType name="PackageItemType">
    <xs:complexContent mixed="false">
      <xs:extension xmlns:q9="UnityEngine.UIElements" base="q9:VisualElementType">
        <xs:choice />
        <xs:attribute name="package-id" type="xs:string" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="PackageItem" xmlns:q10="UnityEngine.UIElements" substitutionGroup="q10:VisualElement" type="tns:PackageItemType" />
  <xs:complexType name="PackageIconType">
    <xs:complexContent mixed="false">
      <xs:extension xmlns:q11="UnityEngine.UIElements" base="q11:VisualElementType">
        <xs:choice />
        <xs:attribute name="package-id" type="xs:string" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="PackageIcon" xmlns:q12="UnityEngine.UIElements" substitutionGroup="q12:VisualElement" type="tns:PackageIconType" />
  <xs:complexType name="DelayedPackageDescriptionBindingType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element xmlns:q13="UnityEngine.UIElements" ref="q13:VisualElement" />
    </xs:choice>
    <xs:attribute name="property" type="xs:string" />
    <xs:attribute default="WhenDirty" name="update-trigger" xmlns:q14="UnityEngine.UIElements" type="q14:BindingUpdateTriggerType" />
    <xs:anyAttribute processContents="lax" />
  </xs:complexType>
  <xs:element name="DelayedPackageDescriptionBinding" type="tns:DelayedPackageDescriptionBindingType" />
  <xs:complexType name="DelayedPackageDocumentationBindingType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element xmlns:q15="UnityEngine.UIElements" ref="q15:VisualElement" />
