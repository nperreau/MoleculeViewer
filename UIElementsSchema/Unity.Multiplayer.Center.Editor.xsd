    <xs:attribute name="property" type="xs:string" />
    <xs:attribute default="WhenDirty" name="update-trigger" xmlns:q26="UnityEngine.UIElements" type="q26:BindingUpdateTriggerType" />
    <xs:anyAttribute processContents="lax" />
  </xs:complexType>
  <xs:element name="DelayedPackageNameBinding" type="tns:DelayedPackageNameBindingType" />
  <xs:complexType name="DelayedPackageIdBindingType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element xmlns:q27="UnityEngine.UIElements" ref="q27:VisualElement" />
    </xs:choice>
    <xs:attribute name="property" type="xs:string" />
    <xs:attribute default="WhenDirty" name="update-trigger" xmlns:q28="UnityEngine.UIElements" type="q28:BindingUpdateTriggerType" />
    <xs:anyAttribute processContents="lax" />
  </xs:complexType>
  <xs:element name="DelayedPackageIdBinding" type="tns:DelayedPackageIdBindingType" />
