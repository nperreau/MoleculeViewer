<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="Unity.Multiplayer.Center.Editor" elementFormDefault="qualified" targetNamespace="Unity.Multiplayer.Center.Editor" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:import schemaLocation="UnityEngine.UIElements.xsd" namespace="UnityEngine.UIElements" />
  <xs:complexType name="RecommendationsGridType">
    <xs:complexContent mixed="false">
      <xs:extension xmlns:q1="UnityEngine.UIElements" base="q1:VisualElementType">
        <xs:choice />
        <xs:attribute name="item-template" type="xs:string" />
        <xs:attribute name="recommendations" type="xs:string" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="RecommendationsGrid" xmlns:q2="UnityEngine.UIElements" substitutionGroup="q2:VisualElement" type="tns:RecommendationsGridType" />
  <xs:complexType name="HelpIconType">
    <xs:complexContent mixed="false">
      <xs:extension xmlns:q3="UnityEngine.UIElements" base="q3:VisualElementType">
        <xs:choice />
        <xs:attribute name="documentation-url" type="xs:string" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="HelpIcon" xmlns:q4="UnityEngine.UIElements" substitutionGroup="q4:VisualElement" type="tns:HelpIconType" />
  <xs:complexType name="QuestionModeSwitcherType">
    <xs:complexContent mixed="false">
      <xs:extension xmlns:q5="UnityEngine.UIElements" base="q5:VisualElementType">
        <xs:choice />
        <xs:attribute default="false" name="question-mode" type="xs:boolean" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="QuestionModeSwitcher" xmlns:q6="UnityEngine.UIElements" substitutionGroup="q6:VisualElement" type="tns:QuestionModeSwitcherType" />
  <xs:complexType name="ImageWithPlaceholderElementType">
    <xs:complexContent mixed="false">
      <xs:extension xmlns:q7="UnityEngine.UIElements" base="q7:ImageType">
