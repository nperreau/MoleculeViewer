    <xs:attribute name="property" type="xs:string" />
    <xs:attribute default="WhenDirty" name="update-trigger" xmlns:q16="UnityEngine.UIElements" type="q16:BindingUpdateTriggerType" />
    <xs:anyAttribute processContents="lax" />
  </xs:complexType>
  <xs:element name="DelayedPackageDocumentationBinding" type="tns:DelayedPackageDocumentationBindingType" />
  <xs:complexType name="CategoriesContainerType">
    <xs:complexContent mixed="false">
      <xs:extension xmlns:q17="UnityEngine.UIElements" base="q17:ScrollViewType">
        <xs:choice />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="CategoriesContainer" xmlns:q18="UnityEngine.UIElements" substitutionGroup="q18:ScrollView" type="tns:CategoriesContainerType" />
  <xs:complexType name="ColoredMinMaxSliderType">
    <xs:complexContent mixed="false">
      <xs:extension xmlns:q19="UnityEngine.UIElements" base="q19:MinMaxSliderType">
        <xs:choice />
