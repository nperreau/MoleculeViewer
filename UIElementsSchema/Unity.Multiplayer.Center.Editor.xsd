    </xs:complexContent>
  </xs:complexType>
  <xs:element name="ColoredMinMaxSlider" xmlns:q20="UnityEngine.UIElements" substitutionGroup="q20:MinMaxSlider" type="tns:ColoredMinMaxSliderType" />
  <xs:complexType name="HyperLinkType">
