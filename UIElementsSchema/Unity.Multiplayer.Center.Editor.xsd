    </xs:complexContent>
  </xs:complexType>
  <xs:element name="HyperLink" xmlns:q22="UnityEngine.UIElements" substitutionGroup="q22:Label" type="tns:HyperLinkType" />
  <xs:complexType name="PackageInfoBindingType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element xmlns:q23="UnityEngine.UIElements" ref="q23:VisualElement" />
    </xs:choice>
    <xs:attribute name="property" type="xs:string" />
    <xs:attribute default="WhenDirty" name="update-trigger" xmlns:q24="UnityEngine.UIElements" type="q24:BindingUpdateTriggerType" />
    <xs:anyAttribute processContents="lax" />
  </xs:complexType>
  <xs:element name="PackageInfoBinding" type="tns:PackageInfoBindingType" />
  <xs:complexType name="DelayedPackageNameBindingType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element xmlns:q25="UnityEngine.UIElements" ref="q25:VisualElement" />
